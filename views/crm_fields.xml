<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="crm_new_fields_for_form_view" model="ir.ui.view">
        <field name="name">inherited.crm.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/notebook" position="inside">

                <page string="Lead Information">
                    <!-- Add your custom fields here -->
                    <group>
                        <group>

                            <!--                            <field name="assign_to_tele_caller_id"/>-->
                            <field name="assigned_date"/>
                            <field name="district"/>
                            <field name="mode_of_study"/>
                            <field name="academic_year"/>
                            <field name="course_id"/>
                            <field name="branch_id"/>
                            <field name="batch_id"/>
                            <field name="institute_name" string="College/School"/>

<!--                            &lt;!&ndash;                            <field name="course_type"/>&ndash;&gt;-->


<!--                            <field name="lead_status_updated_date"/>-->
<!--                            <field name="seminar_lead_id" invisible="1"/>-->

<!--                            &lt;!&ndash;                            <field name="lead_quality"/>&ndash;&gt;-->
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="lead_quality" style="background:#fac17f;"/>
                <field name="updated_remarks"/>
                <field name="expected_joining_date" invisible="lead_quality not in ['warm','hot']"/>
                <field name="department"/>

                <field name="admission_status"/>
                <field name="admission_date"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="assign_to_tele_caller_id" style="background:#fac17f;"/>
            </xpath>
            <!--            <xpath expr="//field[@name='phone']" position="after">-->
            <!--                -->
            <!--            </xpath>-->
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='priority']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!--            <xpath expr="//button[@name='395']" position="attributes">-->
<!--                <attribute name="invisible">1</attribute>-->
<!--            </xpath>-->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">lead_quality != 'admission'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="string">Admission</attribute>
            </xpath>
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="string">Create Invoice</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button name="act_connect_lead" type="object" string="Update Connection Status" class="oe_highlight"
                        invisible="lead_quality in ['waiting_for_admission','admission','bad_lead']"/>
                <!--                <button name="action_send_notification" type="object" string="Add Notification"/>-->
            </xpath>
            <xpath expr="//field[@name='probability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Lead Owner</attribute>
            </xpath>
        </field>

    </record>
    <record id="crm_new_fields_for_list_view" model="ir.ui.view">
        <field name="name">inherited.crm.list.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='contact_name']" position="after">
                <field name="phone" widget="phone"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="assign_to_tele_caller_id"/>
            </xpath>
        </field>
    </record>
