<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inherited_admission_view_form" model="ir.ui.view">
        <field name="name">inherited.admission.form.inherit</field>
        <field name="model">op.admission.register</field>
        <field name="inherit_id" ref="openeducat_admission.view_op_admission_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='academic_years_id']" position="after">
                <field name="admission_date" invisible="state in ['draft']"/>
                <field name="lead_id"/>
            </xpath>

        </field>
    </record>
</odoo>